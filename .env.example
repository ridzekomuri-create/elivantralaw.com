# Gmail account that will authenticate and send the message (usually the same
# address as CONTACT_TO_EMAIL). Requires an "App Password", not the normal
# Google account password — see README section on setting this up.
SMTP_USER=elivantralaw@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=elivantralaw@gmail.com

# Random string used to sign login sessions — generate your own, e.g. with
# `python -c "import secrets; print(secrets.token_hex(24))"`.
SECRET_KEY=change-me-to-a-random-string

# Password to log into /admin (change this to something only you know).
ADMIN_PASSWORD=change-me
